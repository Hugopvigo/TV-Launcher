<?xml version="1.0" encoding="utf-8"?>
<!--
  Panel del desplegable de entradas: cristal oscuro con esquinas muy
  redondeadas y borde luminoso.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:endColor="#F21A1A1C"
        android:startColor="#F22A2A2E"
        android:type="linear" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="#40FFFFFF" />
</shape>
