<?xml version="1.0" encoding="utf-8"?>
<!--
  Pastilla de la barra superior. Sin reborde: el estado enfocado se
  distingue solo por el relleno mas claro.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#5CFFFFFF"
                android:startColor="#8CFFFFFF"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#14FFFFFF"
                android:startColor="#2EFFFFFF"
                android:type="linear" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</selector>
