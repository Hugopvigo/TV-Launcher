<?xml version="1.0" encoding="utf-8"?>
<!-- Pastilla translucida (estilo "cristal"): sin desenfoque, solo color y borde. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/pill" />
    <corners android:radius="22dp" />
    <stroke
        android:width="1dp"
        android:color="@color/pill_stroke" />
</shape>
