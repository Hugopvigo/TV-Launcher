<?xml version="1.0" encoding="utf-8"?>
<!--
  Fondo del launcher: negro puro en el borde inferior, con un halo muy
  suave arriba a la izquierda. Da profundidad sin llegar a ser un color.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FF000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerX="0.25"
                android:centerY="0.15"
                android:gradientRadius="900dp"
                android:startColor="#14161C"
                android:centerColor="#0A0B0F"
                android:endColor="#000000"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
