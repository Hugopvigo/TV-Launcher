<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla del launcher.

  Estructura vertical:
    - Barra superior (fija)
    - Rejilla de 4 columnas (ocupa el espacio libre)
    - Nombre de la app del dock enfocada
    - Banda del dock (fija)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============ Barra superior ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="28dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_regular"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/greeting_size"
                tools:text="Buenas tardes" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extralight"
                android:includeFontPadding="false"
                android:letterSpacing="-0.03"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock_size"
                tools:text="18:42" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_light"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/date_size"
                tools:text="octubre 20" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_inputs"
                style="@style/Pill"
                android:text="@string/action_inputs" />

            <TextView
                android:id="@+id/btn_wifi"
                style="@style/Pill"
                android:layout_marginStart="12dp"
                android:text="@string/action_wifi" />

            <TextView
                android:id="@+id/btn_settings"
                style="@style/Pill"
                android:layout_marginStart="12dp"
                android:text="@string/action_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Rejilla ============ -->
    <FrameLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/screen_margin"
            android:paddingEnd="@dimen/screen_margin"
            android:scrollbars="none" />
    </FrameLayout>

    <!-- ============ Nombre de la app del dock enfocada ============ -->
    <TextView
        android:id="@+id/dock_focus_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/outfit_light"
        android:gravity="center"
        android:paddingBottom="14dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/focused_name_size"
        tools:text="YouTube" />

    <!-- ============ Banda del dock ============ -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dock_height"
        android:background="@drawable/dock_band">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">

            <com.suop.tvlauncher.ui.RoundedIcon
                android:id="@+id/dock_0"
                style="@style/DockIcon"
                tools:src="@mipmap/ic_launcher" />

            <com.suop.tvlauncher.ui.RoundedIcon
                android:id="@+id/dock_1"
                style="@style/DockIcon"
                tools:src="@mipmap/ic_launcher" />

            <com.suop.tvlauncher.ui.RoundedIcon
                android:id="@+id/dock_2"
                style="@style/DockIcon"
                tools:src="@mipmap/ic_launcher" />

            <com.suop.tvlauncher.ui.RoundedIcon
                android:id="@+id/dock_3"
                style="@style/DockIcon"
                tools:src="@mipmap/ic_launcher" />
        </LinearLayout>
    </FrameLayout>

</LinearLayout>

    <!-- Desplegable de entradas, por encima de todo -->
    <LinearLayout
        android:id="@+id/inputs_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="10dp"
        android:visibility="gone"
        tools:visibility="gone" />

</FrameLayout>
