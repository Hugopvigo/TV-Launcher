<?xml version="1.0" encoding="utf-8"?>
<!--
  Pantalla del launcher.

  Estructura vertical:
    - Barra superior: saludo, reloj y fecha a la izquierda; menus a la derecha.
    - Rejilla de 4 columnas con todas las apps, ocupando todo el ancho.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/launcher_background">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- ============ Barra superior ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="@dimen/screen_margin"
        android:paddingTop="34dp"
        android:paddingEnd="@dimen/screen_margin"
        android:paddingBottom="18dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_medium"
                android:letterSpacing="0.02"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/greeting_size"
                tools:text="Buenas tardes" />

            <TextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/outfit_extralight"
                android:includeFontPadding="false"
                android:letterSpacing="-0.04"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/clock_size"
                tools:text="19:42" />

            <TextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="@font/outfit_light"
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/date_size"
                tools:text="martes, 20 de octubre" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/btn_inputs"
                style="@style/Pill"
                android:drawableStart="@drawable/ic_inputs"
                android:text="@string/action_inputs" />

            <TextView
                android:id="@+id/btn_wifi"
                style="@style/Pill"
                android:layout_marginStart="14dp"
                android:drawableStart="@drawable/ic_wifi"
                android:text="@string/action_wifi" />

            <TextView
                android:id="@+id/btn_settings"
                style="@style/Pill"
                android:layout_marginStart="14dp"
                android:drawableStart="@drawable/ic_settings"
                android:text="@string/action_settings" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Rejilla: todas las apps, a todo el ancho ============ -->
    <FrameLayout
        android:id="@+id/grid_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="@dimen/grid_margin"
            android:paddingEnd="@dimen/grid_margin"
            android:paddingBottom="@dimen/grid_margin"
            android:scrollbars="none" />
    </FrameLayout>

</LinearLayout>

    <!-- Desplegable de entradas, por encima de todo -->
    <LinearLayout
        android:id="@+id/inputs_panel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="96dp"
        android:layout_marginEnd="@dimen/screen_margin"
        android:background="@drawable/glass_panel"
        android:orientation="vertical"
        android:padding="8dp"
        android:visibility="gone"
        tools:visibility="gone" />

</FrameLayout>
